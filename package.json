{
  "name": "imperium-interstellar-simulator",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "start": "NODE_ENV=production node server/index.js",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name imperium-solutions-simulator --branch main --commit-dirty=true --force",
    "sync": "node scripts/auto-sync.js --once",
    "watch:sync": "node scripts/auto-sync.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cors": "^2.8.5",
    "d3-geo": "^3.1.1",
    "dotenv": "^18.0.9",
    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1",
    "sane-topojson": "^4.0.0",
    "tailwindcss": "^4.1.0",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1",
    "vite": "^6.2.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "wrangler": "^4.155.0"
  }
}
